<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FB">

    <!-- Application Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#193C69"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="#FFFFFF" />

    <!-- Scrollable Calculator Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enter your baggage information below to calculate the excess baggage fee."
            android:textColor="#526277"
            android:textSize="14sp" />

        <!-- Input Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Baggage Information"
            android:textColor="#193C69"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Baggage Weight -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Baggage Weight (kg)"
            android:textColor="#26364B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Example: 25"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#26364B"
            android:textColorHint="#8290A0" />

        <!-- Ticket Class -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ticket Class"
            android:textColor="#26364B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioEconomy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Economy"
                android:textColor="#26364B"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioBusiness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Business"
                android:textColor="#26364B"
                android:textSize="15sp" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Economy: 20 kg free | Business: 40 kg free"
            android:textColor="#526277"
            android:textSize="13sp" />

        <!-- Excess Baggage Rate -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Excess Baggage Rate (RM/kg)"
            android:textColor="#26364B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Example: 15"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#26364B"
            android:textColorHint="#8290A0" />

        <!-- Calculate Button -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="#158F8B"
            android:text="Calculate Fee"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Reset Button -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#63758C"
            android:text="Reset"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- About Page Button -->
        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#193C69"
            android:text="About BaggageWise"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Result Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E4F3F1"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculation Results"
                android:textColor="#193C69"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Excess Weight -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Excess Baggage Weight"
                android:textColor="#526277"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textExcessWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0.00 kg"
                android:textColor="#193C69"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Excess Charge -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Excess Baggage Charge"
                android:textColor="#526277"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textExcessCharge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RM 0.00"
                android:textColor="#193C69"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Total Payable -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Total Amount Payable (Including 8% Tax)"
                android:textColor="#526277"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textTotalPayable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="RM 0.00"
                android:textColor="#158F8B"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Helpful Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Note: No excess baggage fee applies when your baggage weight is within the allowance. An 8% service tax applies to excess baggage charges."
            android:textColor="#63758C"
            android:textSize="12sp" />

    </LinearLayout>

    </ScrollView>

</LinearLayout>