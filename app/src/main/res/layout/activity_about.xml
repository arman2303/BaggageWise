<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#193C69"
            android:gravity="center"
            android:padding="22dp"
            android:text="About BaggageWise"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- App Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="BaggageWise"
            android:textColor="#193C69"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- App Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="BaggageWise is a mobile application designed to help airline passengers estimate excess baggage fees based on baggage weight, ticket class, and excess baggage rate."
            android:textColor="#526277"
            android:textSize="15sp" />

        <!-- Developer Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developer Information"
                android:textColor="#193C69"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Name: Arman Syazwi Adli Bin Ahmad Fadzli"
                android:textColor="#26364B"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Student Number: 2025238332"
                android:textColor="#26364B"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Group: RCDCS2405A"
                android:textColor="#26364B"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Programme Code: CS240"
                android:textColor="#26364B"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Application Website -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Application Website"
            android:textColor="#193C69"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autoLink="web"
            android:linksClickable="true"
            android:text="https://github.com/arman2303/BaggageWise"
            android:textColorLink="#158F8B"
            android:textSize="15sp" />

        <!-- Copyright -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="© 2026 BaggageWise. All rights reserved."
            android:textColor="#63758C"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
